project_id = "YOUR_PROJECT_ID"
region     = "YOUR_REGION"
huggingface_token_secret_id = "alex-huggingface-token"
# To use Nscale, uncomment these and use a model ID from its catalog.
# llm_provider           = "nscale"
# llm_model              = "YOUR_NSCALE_MODEL_ID"
# nscale_token_secret_id = "alex-nscale-token"

agent_image_urls = {
  planner   = "YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/alex-agents/planner:dev"
  tagger    = "YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/alex-agents/tagger:dev"
  reporter  = "YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/alex-agents/reporter:dev"
  charter   = "YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/alex-agents/charter:dev"
  retirement = "YOUR_REGION-docker.pkg.dev/YOUR_PROJECT_ID/alex-agents/retirement:dev"
}

agent_service_account_email = "alex-agents@YOUR_PROJECT_ID.iam.gserviceaccount.com"
api_service_account_email   = "alex-api@YOUR_PROJECT_ID.iam.gserviceaccount.com"

database_connection_name    = "YOUR_PROJECT_ID:YOUR_REGION:alex-postgres"
database_name               = "alex"
database_user               = "alex_app"
database_password_secret_id = "alex-cloud-sql-password"

ingestion_service_name     = "alex-ingestion"
ingestion_service_region   = "YOUR_REGION"
ingestion_service_url      = "https://YOUR_INGESTION_SERVICE_URL"
ingestion_service_audience = "https://YOUR_INGESTION_SERVICE_URL"

# Optional: omit when price lookups are not configured.
# massive_api_key_secret_id = "alex-massive-api-key"
