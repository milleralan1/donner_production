FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/database:/app/api \
    PORT=8080

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml ./api/pyproject.toml
COPY database/pyproject.toml ./database/pyproject.toml
COPY scheduler/pyproject.toml ./scheduler/pyproject.toml
COPY database ./database
COPY api ./api

WORKDIR /app/api
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && uv sync --project . --extra gcp --no-install-project --no-dev --frozen \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/* /root/.cache/uv

RUN useradd --create-home --uid 10001 app \
    && chown -R app:app /app
USER app

EXPOSE 8080
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
