FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
COPY ingest/pyproject.toml ingest/uv.lock /app/ingest/
COPY database/ /app/database/
WORKDIR /app/ingest
RUN uv sync --frozen --no-install-project --no-dev
COPY ingest/vertex_embeddings.py ingest/nscale_embeddings.py ingest/embedding_client.py ingest/gcp_ingestion.py ingest/gcp_service.py ./

CMD ["/app/ingest/.venv/bin/uvicorn", "gcp_service:app", "--host", "0.0.0.0", "--port", "8080"]
